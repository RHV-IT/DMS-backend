# ============================================================
# .env.example - Complete Environment Configuration for DMS Backend
# ============================================================
# PRODUCTION DEPLOYMENT SETUP
# Copy this file to .env and fill in your production values:
#   cp .env.example .env
#
# SECURITY NOTES:
# - Never commit .env to git
# - Use strong, unique passwords
# - Rotate secrets regularly
# - Use different values for each environment
# ============================================================

# ---- APPLICATION CONFIGURATION ----
NODE_ENV=production
SERVICE_NAME=dms-backend
API_PORT=5000
SCANNER_PORT=4001
NGINX_PORT=80
NGINX_SSL_PORT=443

# ---- CORS CONFIGURATION ----
# Exact origins that MUST work (no exceptions)
ALLOWED_ORIGINS=http://192.168.0.153:3000,http://docmanager.rhv,http://localhost:3000,https://rhv-dms.vercel.app
FRONTEND_URL=https://rhv-dms.vercel.app
CLIENT_URL=https://rhv-dms.vercel.app

# ---- JWT AUTHENTICATION (REQUIRED) ----
# Generate strong secrets: openssl rand -base64 64
JWT_SECRET=your-super-secure-jwt-secret-minimum-64-characters-long
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-minimum-64-characters-long
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d
JWT_MAX_AGE=7200000
JWT_REMEMBER_MAX_AGE=604800000

# ---- DATABASE CONFIGURATION ----
# MongoDB Atlas (Production)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/dms?retryWrites=true&w=majority

# PostgreSQL (Future use - optional)
POSTGRES_DB=dms
POSTGRES_USER=dms_user
POSTGRES_PASSWORD=your-super-secure-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (Sessions & Caching)
REDIS_PASSWORD=your-super-secure-redis-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ---- SECURITY CONFIGURATION ----
# Admin registration (one-time use)
ADMIN_SECRET=dms_admin_secret_production_only

# Password policy
PASSWORD_EXPIRE_DAYS=90
PASSWORD_HISTORY_LIMIT=5
MIN_PASSWORD_LENGTH=8

# File upload security
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Cookie security
COOKIE_DOMAIN=.yourdomain.com
SAME_SITE_POLICY=none

# ---- SCANNER CONFIGURATION ----
SCANNER_TOKEN=your-jwt-token-for-scanner-authentication
UPLOAD_DELAY_MS=2000

# ---- EMAIL CONFIGURATION (Optional) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="DMS System" <your-email@gmail.com>

# ---- MONITORING & LOGGING ----
LOG_LEVEL=info
ENABLE_SWAGGER=true

# ---- BACKUP CONFIGURATION ----
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ---- DEPLOYMENT SECRETS ----
# These should be set as GitHub secrets for CI/CD
# DEPLOY_HOST=your-server-ip
# DEPLOY_USER=your-ssh-user
# DEPLOY_SSH_KEY=your-private-key
# DEPLOY_WEBHOOK_URL=https://your-deployment-webhook

# ---- SSL/HTTPS CONFIGURATION ----
# For production HTTPS (uncomment when using SSL)
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem
# FORCE_HTTPS=true

# ---- RATE LIMITING ----
# API rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ---- MONITORING ----
# Health check configuration
HEALTH_CHECK_INTERVAL=30s
HEALTH_CHECK_TIMEOUT=10s
HEALTH_CHECK_RETRIES=3

# ---- DEVELOPMENT OVERRIDES ----
# Uncomment for local development
# NODE_ENV=development
# MONGODB_URI=mongodb://localhost:27017/dms
# REDIS_PASSWORD=
# ENABLE_SWAGGER=true