# ============================================================
# .env.example - Required environment variables for docker-compose
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# ---- MongoDB Atlas (REQUIRED) ----
# Get your connection string from MongoDB Atlas:
#   Atlas → Clusters → Connect → Connect your application → Copy URI
MONGODB_URI=mongodb+srv://psalmuelsapok_db_user:YOUR_PASSWORD@dms.gxomq4e.mongodb.net/dms

# ---- JWT Secrets (REQUIRED) ----
# Generate strong secrets: openssl rand -base64 64
JWT_SECRET=your-super-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# ---- CORS ----
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://rhv-dms.vercel.app,https://rhv-dms.com

# ---- Scanner ----
# JWT token for scanner authentication (set after creating scanner user)
SCANNER_TOKEN=your-jwt-token-here

# ---- Frontend URL ----
FRONTEND_URL=https://rhv-dms.vercel.app
CLIENT_URL=https://rhv-dms.vercel.app

# ---- Server ----
PORT=5000

# ---- File Upload ----
MAX_FILE_SIZE=52428800