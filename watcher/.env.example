# Scanner Watcher Configuration (Pending Mode)

# Directory to watch for scanned files
SCAN_DIR=C:/Users/user/Documents/Scan

# Backend API endpoint for pending scans
PENDING_API_URL=http://localhost:5000/api/v1/scanner/pending

# JWT token for authentication (REQUIRED)
# Obtain this by running: node create-scanner-user.js
SCANNER_TOKEN=your-jwt-token-here

# Delay before sending to pending (milliseconds)
# Recommended: 2000ms (2 seconds) to ensure file is fully written
UPLOAD_DELAY_MS=2000

# NOTES:
# - Files are NOT deleted from SCAN_DIR after sending to pending
# - Files remain in the scan folder until manually confirmed/cancelled in web app
# - After confirmation in web app, backend converts format and deletes original
