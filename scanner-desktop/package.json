{
  "name": "rhv-dms-scanner-desktop",
  "version": "1.0.0",
  "description": "Document Scanner Agent - Automatically scan and upload documents to DMS",
  "main": "main.js",
  "homepage": "https://rhv-dms.vercel.app",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "dist": "electron-builder --publish=never",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": ["scanner", "documents", "upload", "desktop"],
  "author": {
    "name": "RHV DMS Team",
    "email": "support@rhv-dms.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/rhv-dms/scanner-desktop"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.7.7",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "uuid": "^9.0.0"
  },
  "build": {
    "appId": "com.document.scanner.desktop",
    "productName": "Document Scanner Agent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!build/**/*",
      "!*.md",
      "!BUILD.md",
      "!test-install.bat",
      "!build.bat",
      "!check-icons.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "sign": false,
      "verifyUpdateCodeSignature": false,
      "executableName": "DocumentScannerAgent"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Document Scanner Agent",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "1033",
      "include": "installer.nsh"
    }
  }
}