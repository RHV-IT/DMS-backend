{
  "name": "rhv-scanner-agent",
  "version": "1.0.0",
  "description": "RHV Scanner Agent - Document scanning and upload agent",
  "main": "main.js",
  "homepage": "https://rhv-dms.vercel.app",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never"
  },
  "author": "RHV DMS Team",
  "license": "ISC",
  "devDependencies": {
    "electron": "^25.9.8",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "axios": "^1.7.7",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "mime-types": "^3.0.2",
    "uuid": "^9.0.0"
  },
  "build": {
    "appId": "com.rhv.scanner",
    "productName": "RHV Scanner Agent",
    "asar": true,
    "files": [
      "**/*",
      "!dist/*",
      "!release/*"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
