# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/dms

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

# Password Policy
PASSWORD_EXPIRE_DAYS=90
PASSWORD_HISTORY_LIMIT=5
MIN_PASSWORD_LENGTH=8

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_PATH=./uploads

# Swagger
ENABLE_SWAGGER=true
CLIENT_URL=http://localhost:5173

# Frontend URL (used in emails, e.g. "Open RHV DMS" login button)
FRONTEND_URL=http://192.168.0.153:3000

# Email (SMTP) - required for automatic welcome emails on user creation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="RHV Document Management System" <your-email@gmail.com>